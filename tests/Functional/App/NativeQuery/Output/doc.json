                },
                "type": "object",
                "readOnly": true
            },
            "BadRequestErrorView": {
                "properties": {
                    "type": {
                        "type": "string",
                        "default": "https://tools.ietf.org/html/rfc2616#section-10"
                    },
                    "title": {
                        "type": "string",
